{
  "private": true,
  "name": "iamgld.dev",
  "version": "21.2.0",
  "author": "Gregory López",
  "homepage": "https://iamgld.dev",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.13.0 <25.0.0",
    "pnpm": ">=10.28.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve -c local",
    "start:open": "ng serve -c local --open",
    "start:host": "ng serve -c local --host 0.0.0.0",
    "start:dev": "ng serve -c development",
    "start:stag": "ng serve -c staging",
    "start:prod": "ng serve -c production",
    "test": "ng test",
    "test:watch": "ng test",
    "build": "pnpm run build:prod",
    "build:dev": "ng build -c development --progress",
    "build:stag": "ng build -c staging --progress",
    "build:prod": "ng build -c production --progress",
    "build:iamgld-ui-lib": "ng build --project=iamgld-ui-lib",
    "server:ssr": "node dist/iamgld.dev/server/server.mjs",
    "npm:publish": "pnpm build:iamgld-ui-lib && cd dist/iamgld-ui-lib && npm publish",
    "prettier:": "prettier \"src/**/*.{ts,html,scss,css,js,json,md}\" --check --config .prettierrc",
		"prettier:fix": "prettier \"src/**/*.{ts,html,scss,css,js,json,md}\" --write --config .prettierrc",
		"stylelint": "stylelint  src/**/*.{css,scss}",
		"stylelint:fix": "stylelint --fix  src/**/*.{css,scss}",
		"eslint": "ng lint",
		"eslint:fix": "ng lint --fix",
		"linter": "npm run prettier:fix && npm run eslint:fix && npm run stylelint:fix",
    "postinstall": "npx husky"
  },
  "dependencies": {
    "@angular/common": "21.1.0",
    "@angular/compiler": "21.1.0",
    "@angular/core": "21.1.0",
    "@angular/forms": "21.1.0",
    "@angular/platform-browser": "21.1.0",
    "@angular/platform-server": "21.1.0",
    "@angular/router": "21.1.0",
    "@angular/ssr": "21.1.0",
    "@jsverse/transloco": "8.2.0",
    "@ngrx/signals": "21.0.1",
    "express": "5.2.1",
    "ngx-cookie-service": "21.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.1.0",
    "@angular/cli": "21.1.0",
    "@angular/compiler-cli": "21.1.0",
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "@testing-library/angular": "19.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@types/express": "5.0.6",
    "@types/node": "25.0.9",
    "angular-eslint": "21.2.0",
    "eslint": "9.39.2",
    "@eslint/js": "9.39.2",
    "globals": "17.3.0",
    "lint-staged": "16.2.7",
		"prettier": "3.8.1",
    "husky": "9.1.7",
    "jsdom": "28.0.0",
    "ng-packagr": "21.1.0",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-selector-bem-pattern": "4.0.1",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
