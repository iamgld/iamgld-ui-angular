{
	"servers": {
		"angular-cli": {
			"command": "npx",
			"args": ["-y", "@angular/cli", "mcp"]
		},
		"chrome-devtools": {
			"command": "npx",
			"args": ["-y", "chrome-devtools-mcp@latest"],
			"type": "stdio"
		},
		"vitest-runner": {
			"command": "npx",
			"args": ["-y", "@madrus/vitest-mcp-server@latest"],
			"env": {
				"VITEST_PROJECT_DIR": "/Users/gregor/Projects/iamgld/iamgld-ui"
			}
		}
	}
}
