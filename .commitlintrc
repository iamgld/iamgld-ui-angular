{
	"extends": [
		"@commitlint/config-conventional"
	],
	"rules": {
		"header-max-length": [
			2,
			"always",
			400
		],
		"body-max-length": [
			2,
			"always",
			2000
		],
		"body-max-line-length": [
			2,
			"always",
			400
		],
		"footer-max-line-length": [
			2,
			"always",
			400
		],
	}
}
