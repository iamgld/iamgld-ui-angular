#!/usr/bin/env sh
set -e


# Load local system configuration if exists (e.g. for Homebrew on macOS)
if [ -f "$HOME/.huskyrc" ]; then
  . "$HOME/.huskyrc"
fi

# Inicializar fnm si está disponible
if command -v fnm >/dev/null 2>&1; then
    eval "$(fnm env --use-on-cd --shell sh)"
fi

# Inicializar pnpm si es necesario (añadir su home al PATH)
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

[ "${HUSKY:-1}" = "0" ] && exit 0

echo "[hook commit-msg] Running commitlint..."

# Ensure Node is available in Git Bash (fnm-managed Node)
if command -v fnm >/dev/null 2>&1; then
	eval "$(fnm env --use-on-cd)"
	fnm use --install-if-missing >/dev/null 2>&1 || true
fi

# Prefer pnpm (local bin), then npx (no install), then yarn
if command -v pnpm >/dev/null 2>&1; then
	pnpm exec commitlint --edit "$1"
elif command -v npx >/dev/null 2>&1; then
	npx --no-install commitlint --edit "$1"
elif command -v yarn >/dev/null 2>&1; then
	yarn commitlint --edit "$1"
else
	echo "husky: No package runner found (pnpm/npx/yarn)." >&2
	exit 127
fi
