{
  "private": true,
  "name": "iamgld.dev",
  "version": "21.1.0",
  "author": "Gregory López",
  "homepage": "https://iamgld.dev",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -c local",
    "start:open": "ng serve -c local --open",
    "start:host": "ng serve -c local --host 0.0.0.0",
    "start:dev": "ng serve -c development",
    "start:stag": "ng serve -c staging",
    "start:prod": "ng serve -c production",
    "test": "ng test",
    "test:watch": "ng test",
    "build": "pnpm run build:prod",
    "build:dev": "ng build -c development --progress",
    "build:stag": "ng build -c staging --progress",
    "build:prod": "ng build -c production --progress",
    "build:iamgld-ui-lib": "ng build --project=iamgld-ui-lib",
    "server:ssr": "node dist/iamgld.dev/server/server.mjs",
    "stylelint": "stylelint  src/**/*.{css,scss}",
    "stylelint:fix": "stylelint --fix  src/**/*.{css,scss}",
    "biome:check": "pnpm exec biome check --write src/",
    "biome:format": "pnpm exec biome format --write src/",
    "biome:lint": "pnpm exec biome lint --write src/",
    "linters": " pnpm stylelint:fix && pnpm biome:format && pnpm biome:lint",
    "npm:publish": "pnpm build:iamgld-ui-lib && cd dist/iamgld-ui-lib && npm publish",
    "postinstall": "npx husky"
  },
  "dependencies": {
    "@angular/common": "21.1.0",
    "@angular/compiler": "21.1.0",
    "@angular/core": "21.1.0",
    "@angular/forms": "21.1.0",
    "@angular/platform-browser": "21.1.0",
    "@angular/platform-server": "21.1.0",
    "@angular/router": "21.1.0",
    "@angular/ssr": "21.1.0",
    "@jsverse/transloco": "8.2.0",
    "@ngrx/signals": "21.0.1",
    "express": "5.2.1",
    "ngx-cookie-service": "21.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.1.0",
    "@angular/cli": "21.1.0",
    "@angular/compiler-cli": "21.1.0",
    "@biomejs/biome": "2.3.11",
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "@testing-library/angular": "19.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@types/express": "5.0.6",
    "@types/node": "25.0.9",
    "husky": "9.1.7",
    "jsdom": "27.4.0",
    "ng-packagr": "21.1.0",
    "stylelint": "17.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-selector-bem-pattern": "4.0.1",
    "typescript": "5.9.3",
    "vitest": "4.0.17"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=7.18.2",
      "qs": ">=6.14.1",
      "tar": ">=7.5.3"
    }
  }
}
