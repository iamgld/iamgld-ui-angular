{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Chrome (Modo Inseguro)",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:4200",
			"webRoot": "${workspaceFolder}",
			"runtimeArgs": [
				"--disable-web-security",
				"--ignore-certificate-errors"
			],
			"windows": {
				"runtimeArgs": [
					"--disable-web-security",
					"--ignore-certificate-errors",
					"--user-data-dir=C:\\temp\\chrome-dev"
				]
			},
			"osx": {
				"runtimeArgs": [
					"--disable-web-security",
					"--ignore-certificate-errors",
					"--user-data-dir=${workspaceFolder}/.vscode/chrome-dev"
				]
			}
		}
	]
}
